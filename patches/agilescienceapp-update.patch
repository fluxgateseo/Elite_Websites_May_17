From daa0d8917638a604fd6361d3ff61afbe4a5e3ace Mon Sep 17 00:00:00 2001
From: c <c@l>
Date: Tue, 19 May 2026 13:53:32 +0000
Subject: [PATCH 3/3] Interlink: 'Articoli correlati' (same-category) on every
 article

---
 src/layouts/ArticleLayout.astro | 38 ++++++++++++++++++++++++++++++++-
 1 file changed, 37 insertions(+), 1 deletion(-)

diff --git a/src/layouts/ArticleLayout.astro b/src/layouts/ArticleLayout.astro
index 211fe53..983d338 100644
--- a/src/layouts/ArticleLayout.astro
+++ b/src/layouts/ArticleLayout.astro
@@ -1,5 +1,6 @@
 ---
 import BaseLayout from "./BaseLayout.astro";
+import { getCollection } from "astro:content";
 import { articleSchema, breadcrumbSchema } from "../lib/schema";
 import { buildCanonical, buildOgImage } from "../lib/seo";
 import config from "../site.config";
@@ -50,6 +51,17 @@ const crumbs = [
   { name: title, url: canonicalUrl },
 ];
 const schemas = [artSchema, breadcrumbSchema(crumbs)];
+
+const _all = await getCollection("articoli");
+const _slug = (a: any) => a.data.slug ?? a.id.replace(/\.md$/, "");
+const related = _all
+  .filter((a) => _slug(a) !== slug)
+  .sort((a, b) => {
+    const sc = (x: any) => (x.data.category === category ? 0 : 1);
+    return sc(a) - sc(b) || new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
+  })
+  .slice(0, 3)
+  .map((a) => ({ title: a.data.title, slug: _slug(a), category: a.data.category }));
 ---
 <BaseLayout
   title={title}
@@ -111,9 +123,33 @@ const schemas = [artSchema, breadcrumbSchema(crumbs)];
       <slot name="toc" />
     </aside>
 
+    {related.length > 0 && (
+      <nav
+        aria-label="Articoli correlati"
+        class="max-w-3xl border-t mt-16 pt-8"
+        style="border-color:var(--color-divider)"
+      >
+        <p class="text-xs font-medium uppercase tracking-widest mb-4" style="color:var(--color-accent)">Articoli correlati</p>
+        <ul class="space-y-3 list-none p-0 m-0">
+          {related.map((r) => (
+            <li>
+              <a
+                href={`/blog/${r.slug}/`}
+                class="no-underline hover:underline font-medium"
+                style="color:var(--color-fg)"
+              >
+                {r.title}
+              </a>
+              <span class="text-xs ml-2" style="color:var(--color-muted)">{r.category}</span>
+            </li>
+          ))}
+        </ul>
+      </nav>
+    )}
+
     <!-- Back link -->
     <div
-      class="max-w-3xl border-t mt-16 pt-8"
+      class="max-w-3xl border-t mt-12 pt-8"
       style="border-color:var(--color-divider)"
     >
       <a
