From d57889d66a817b622eab2e2b1cde52629118b2a5 Mon Sep 17 00:00:00 2001
From: c <c@l>
Date: Tue, 19 May 2026 12:48:46 +0000
Subject: [PATCH] Fix unreadable text: map --color-fg/muted/divider from
 palette

Same BaseLayout contrast bug as the sibling site: --color-fg was
never remapped from the palette, yielding white-on-white under OS
dark mode. Derive fg/muted/divider from palette primary.
---
 src/layouts/BaseLayout.astro | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/layouts/BaseLayout.astro b/src/layouts/BaseLayout.astro
index 0d8e11d..4c33058 100644
--- a/src/layouts/BaseLayout.astro
+++ b/src/layouts/BaseLayout.astro
@@ -90,6 +90,9 @@ const darkModeClass =
       --color-primary: var(--primary);
       --color-accent: var(--accent);
       --color-bg: var(--background);
+      --color-fg: var(--primary);
+      --color-muted: color-mix(in srgb, var(--primary) 60%, var(--background));
+      --color-divider: color-mix(in srgb, var(--primary) 18%, var(--background));
       --font-display: v-display;
       --font-body: v-body;
     }
-- 
2.43.0

