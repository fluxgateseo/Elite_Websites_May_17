                 >
                   {c.label}
@@ -81,7 +143,7 @@ export function PromptButton({ domain, status }: { domain: string; status: strin
 
             <textarea
               value={prompt}
-              onChange={(e) => setPrompt(e.target.value.slice(0, 2000))}
+              onChange={(e) => { setPrompt(e.target.value.slice(0, 2000)); clearState(); }}
               rows={5}
               placeholder="Es: aggiungi una sezione FAQ alla home con 4 domande sul servizio…"
               className="w-full text-sm rounded border border-zinc-300 dark:border-zinc-700 bg-transparent p-2 resize-y"
@@ -92,7 +154,7 @@ export function PromptButton({ domain, status }: { domain: string; status: strin
                 Scope
                 <select
                   value={scope}
-                  onChange={(e) => setScope(e.target.value as Scope)}
+                  onChange={(e) => { setScope(e.target.value as Scope); clearState(); }}
                   className="text-xs rounded border border-zinc-300 dark:border-zinc-700 bg-transparent px-1.5 py-1"
                 >
                   <option value="content">content</option>
@@ -103,33 +165,55 @@ export function PromptButton({ domain, status }: { domain: string; status: strin
               <span className="text-[10px] text-zinc-400">{prompt.length}/2000</span>
             </div>
 
-            <div className="flex items-center justify-end gap-2">
-              <button type="button" onClick={() => !busy && setOpen(false)} className="text-xs px-3 py-1.5 rounded text-zinc-500 hover:text-zinc-700">Annulla</button>
-              <button
-                type="button"
-                onClick={submit}
-                disabled={busy || prompt.trim().length === 0}
-                className="text-xs px-3 py-1.5 rounded bg-blue-600 hover:bg-blue-500 text-white disabled:opacity-50 disabled:cursor-not-allowed"
-              >
-                {busy ? "Applico…" : "Applica modifica"}
-              </button>
-            </div>
+            {/* Confirmation gate: this edits a LIVE site (commit to main +
+                auto-deploy), so make the operator explicitly confirm before
+                we touch anything. */}
+            {confirming ? (
+              <div className="rounded border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-950/40 p-3 space-y-2">
+                <p className="text-xs text-amber-700 dark:text-amber-300">
+                  Stai per modificare <span className="font-mono">{domain}</span>, che è <strong>online</strong>.
+                  Le modifiche verranno committate su <span className="font-mono">main</span> e pubblicate
+                  automaticamente. Vuoi procedere?
+                </p>
+                <div className="flex items-center justify-end gap-2">
+                  <button type="button" onClick={() => setConfirming(false)} className="text-xs px-3 py-1.5 rounded text-zinc-500 hover:text-zinc-700">Annulla</button>
+                  <button
+                    type="button"
+                    onClick={apply}
+                    disabled={busy}
+                    className="text-xs px-3 py-1.5 rounded bg-amber-600 hover:bg-amber-500 text-white disabled:opacity-50 disabled:cursor-not-allowed"
