+                  disabled={busy || prompt.trim().length === 0}
+                  className="text-xs px-3 py-1.5 rounded bg-blue-600 hover:bg-blue-500 text-white disabled:opacity-50 disabled:cursor-not-allowed"
+                >
+                  Applica modifica
+                </button>
+              </div>
+            )}
 
             {result && (
               <div className="text-xs rounded border p-3 border-zinc-200 dark:border-zinc-700">
-                {result.ok ? (
-                  result.filesChanged.length === 0 ? (
-                    <p className="text-amber-600 dark:text-amber-400">Nessuna modifica applicata (l'istruzione non ha prodotto cambiamenti nello scope).</p>
-                  ) : (
-                    <div className="space-y-1">
-                      <p className="text-emerald-600 dark:text-emerald-400">✓ Applicato — commit <span className="font-mono">{result.commitSha.slice(0, 7)}</span>. Il deploy parte in automatico.</p>
-                      <ul className="list-disc list-inside text-zinc-500">
-                        {result.filesChanged.map((f) => <li key={f} className="font-mono text-[10px]">{f}</li>)}
-                      </ul>
-                    </div>
-                  )
