diff --git a/src/components/wizard/wizard-i18n.tsx b/src/components/wizard/wizard-i18n.tsx
new file mode 100644
index 0000000..63dafcf
--- /dev/null
+++ b/src/components/wizard/wizard-i18n.tsx
@@ -0,0 +1,20 @@
+"use client";
+
+import { createContext, useContext, useMemo, type ReactNode } from "react";
+import { makeT, DEFAULT_LANG, type Lang } from "@/lib/i18n";
+
+// The wizard is a deep client tree (container → 11 steps → StepNav). Rather
+// than drill a `lang` prop through every step's Props interface, we expose the
+// translator built from the active language via context. Steps call useT().
+const WizardTContext = createContext<(key: string) => string>(makeT(DEFAULT_LANG));
+
+export function WizardI18nProvider({ lang, children }: { lang: Lang; children: ReactNode }) {
+  // Stable identity per language so consumers' useCallback/useMemo deps that
+  // include `t` don't re-fire on every render.
+  const t = useMemo(() => makeT(lang), [lang]);
+  return <WizardTContext.Provider value={t}>{children}</WizardTContext.Provider>;
+}
+
+export function useT() {
+  return useContext(WizardTContext);
+}
