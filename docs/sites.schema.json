{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fluxgateseo/Elite_Websites_May_17/main/docs/sites.schema.json",
  "title": "Live sites index",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "generatedAt", "sites"],
  "properties": {
    "project": { "const": "Elite_Websites_May_17" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "account", "status"],
        "properties": {
          "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
          "account": { "enum": ["IT", "EN"] },
          "status": { "enum": ["draft", "building", "live", "error", "paused"] },
          "cloudflare_pages_project": { "type": ["string", "null"] },
          "github_repo": { "type": ["string", "null"], "pattern": "^[^/]+/[^/]+$" },
          "scope": {
            "enum": ["managed", "external"],
            "description": "Optional. Absent or \"managed\" = our generated/operated site. \"external\" = collaborator-owned, out of scope, DO NOT EDIT (see docs/infrastructure.md)."
          }
        }
      }
    }
  }
}
