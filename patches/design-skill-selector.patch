diff --git a/tests/wizard-types.test.ts b/tests/wizard-types.test.ts
new file mode 100644
index 0000000..f144567
--- /dev/null
+++ b/tests/wizard-types.test.ts
@@ -0,0 +1,22 @@
+import { describe, it, expect } from "vitest";
+import { defaultWizardState, type DesignSkill } from "../src/lib/wizard-types";
+
+describe("wizard step7 designSkill", () => {
+  it("defaults to null (operator must choose a visual language)", () => {
+    expect(defaultWizardState().step7.designSkill).toBeNull();
+  });
+
+  it("Step7Data carries designSkill in the typed shape", () => {
+    const s = defaultWizardState();
+    const picked: DesignSkill = "art-deco";
+    s.step7.designSkill = picked;
+    expect(s.step7.designSkill).toBe("art-deco");
+  });
+
+  it("submit serialization preserves designSkill (brief is JSON.stringify(state))", () => {
+    const s = defaultWizardState();
+    s.step7.designSkill = "luxury";
+    const roundtrip = JSON.parse(JSON.stringify(s));
+    expect(roundtrip.step7.designSkill).toBe("luxury");
+  });
+});
