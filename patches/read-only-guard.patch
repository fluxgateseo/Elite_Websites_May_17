diff --git a/src/lib/read-only.ts b/src/lib/read-only.ts
new file mode 100644
index 0000000..52ea9fc
--- /dev/null
+++ b/src/lib/read-only.ts
@@ -0,0 +1,20 @@
+/**
+ * Write-freeze flag for the parallel-deploy window.
+ *
+ * Plan reference: `docs/plan-migrate-to-innotofuture.md` M1 — "Add
+ * READ_ONLY=1 env var support to mutating API routes ... freeze writes
+ * during parallel period" — and M6, where the IT worker is frozen at
+ * cutover. Set `READ_ONLY=1` (or `true`) on a worker and every mutating
+ * API route refuses writes with 503 instead of touching D1 / CF / the
+ * pipeline.
+ *
+ * Read at call time (not module load) so tests can stub the env without
+ * resetting modules, matching the rest of the codebase's process.env use.
+ */
+export function isReadOnly(): boolean {
+  const v = process.env.READ_ONLY;
+  return v === "1" || v?.toLowerCase() === "true";
+}
+
+export const READ_ONLY_MESSAGE =
+  "Dashboard is in read-only mode (writes are frozen during the deploy migration).";
diff --git a/tests/read-only.test.ts b/tests/read-only.test.ts
new file mode 100644
index 0000000..840d2ed
--- /dev/null
+++ b/tests/read-only.test.ts
@@ -0,0 +1,46 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+beforeEach(() => {
+  vi.resetModules();
+  vi.unstubAllEnvs();
+});
+
+describe("isReadOnly", () => {
+  it("is false when READ_ONLY is unset", async () => {
+    const { isReadOnly } = await import("../src/lib/read-only");
+    expect(isReadOnly()).toBe(false);
+  });
+
+  it('is true when READ_ONLY="1"', async () => {
+    vi.stubEnv("READ_ONLY", "1");
+    const { isReadOnly } = await import("../src/lib/read-only");
+    expect(isReadOnly()).toBe(true);
+  });
+
+  it('is true when READ_ONLY="true" (any case)', async () => {
+    vi.stubEnv("READ_ONLY", "TRUE");
+    const { isReadOnly } = await import("../src/lib/read-only");
+    expect(isReadOnly()).toBe(true);
+  });
+
+  it('is false for "0", "false", or other values', async () => {
+    for (const v of ["0", "false", "yes", "", "on"]) {
+      vi.stubEnv("READ_ONLY", v);
+      const { isReadOnly } = await import("../src/lib/read-only");
+      expect(isReadOnly(), `value ${JSON.stringify(v)}`).toBe(false);
+      vi.resetModules();
+    }
+  });
+
+  it("re-reads the env at call time (not module load)", async () => {
+    const mod = await import("../src/lib/read-only");
+    expect(mod.isReadOnly()).toBe(false);
+    vi.stubEnv("READ_ONLY", "1");
+    expect(mod.isReadOnly()).toBe(true);
+  });
+
+  it("exposes a non-empty operator-facing message", async () => {
+    const { READ_ONLY_MESSAGE } = await import("../src/lib/read-only");
+    expect(READ_ONLY_MESSAGE).toMatch(/read-only/i);
+  });
+});
